---
// src/layouts/StoreLayout.astro
// Wraps Astrowind's PageLayout and injects Merchant API config +
// shared store components (cart toast, email modal) on every store page.

import PageLayout from '~/layouts/PageLayout.astro';
import CartToast from '~/components/store/CartToast.astro';
import EmailModal from '~/components/store/EmailModal.astro';
import type { MetaData } from '~/types';
import { getLocale, page } from '~/utils/i18n';

interface Props {
  metadata?: MetaData;
  cartUrl?: string;
  cancelUrl?: string;
}

const locale = getLocale(Astro.url.pathname);
const { metadata, cartUrl = page('cart', locale), cancelUrl = page('shop', locale) } = Astro.props;
---

<PageLayout metadata={metadata}>
  <slot />

  <!-- Shared store UI — present on every store page -->
  <CartToast cartUrl={cartUrl} />
  <EmailModal />
</PageLayout>
