---
// One section of a content page (see src/content/pages). `type` picks the widget; the other keys are its props.
import Hero from '~/components/widgets/Hero.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Stats from '~/components/widgets/Stats.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ContactForm from '~/components/store/ContactForm.astro';
import type { Section, FaqGroup } from '~/utils/pages';

interface Props {
  section: Section;
  locale: 'fr' | 'en';
}
const { section, locale } = Astro.props;
// `variant` (optional) is the layout of the section; the other keys are the widget's own props.
const { type, variant, ...rest } = section;
// The remaining keys are the widget's own props, written in the YAML file.
const props = rest as Record<string, never>;
const groups = (rest.groups ?? []) as FaqGroup[];
// hero: split (default) | centered.  features: icons (default) | cards | image (needs an image).  steps: image (default) | numbered.
const featuresLayout = variant === 'cards' ? 'cards' : variant === 'image' && props.image ? 'image' : 'icons';
---

{type === 'hero' && variant === 'centered' && <Hero {...props} />}
{type === 'hero' && variant !== 'centered' && <Hero2 {...props} />}
{type === 'hero-text' && <HeroText {...props} />}
{type === 'features' && featuresLayout === 'icons' && <Features {...props} />}
{type === 'features' && featuresLayout === 'cards' && <Features2 {...props} />}
{type === 'features' && featuresLayout === 'image' && <Features3 {...props} />}
{type === 'features-grid' && <Features2 {...props} />}
{type === 'content' && <Content {...props} />}
{type === 'steps' && variant !== 'numbered' && <Steps {...props} />}
{type === 'steps' && variant === 'numbered' && <Steps2 {...props} />}
{type === 'stats' && <Stats {...props} />}
{type === 'testimonials' && <Testimonials {...props} />}
{type === 'cta' && <CallToAction {...props} />}
{type === 'contact-form' && <ContactForm locale={locale} />}
{
  type === 'prose' && (
    <div class="max-w-3xl mx-auto px-6 pb-16 prose dark:prose-invert prose-headings:font-heading prose-headings:font-bold prose-a:text-primary" set:html={props.html} />
  )
}
{
  type === 'faq' && (
    <div class="max-w-3xl mx-auto px-6 pb-16 space-y-10">
      {groups.map((group) => (
        <section>
          <h2 class="font-heading font-bold text-xl mb-4">{group.title}</h2>
          <div class="space-y-3">
            {group.items.map((item) => (
              <details class="group rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 open:shadow-sm">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium text-default [&::-webkit-details-marker]:hidden">
                  <span>{item.q}</span>
                  <svg class="h-5 w-5 shrink-0 text-primary transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                  </svg>
                </summary>
                <div class="px-5 pb-5 text-sm text-muted leading-relaxed">
                  <p>{item.a}</p>
                  {item.link && (
                    <p class="mt-3">
                      <a
                        href={item.link.href}
                        class="font-medium text-primary hover:underline"
                        {...(item.link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      >
                        {item.link.label} →
                      </a>
                    </p>
                  )}
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>
  )
}
