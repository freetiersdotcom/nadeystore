---
// src/components/common/LanguageSwitcher.astro
// FR | EN toggle. Links to the same page in the other language.
// Plain <a> links so it also works with SSR product pages. Pages that carry
// state in the query string (downloads ?token=, confirmation ?cart_id=) are
// built statically, so Astro.url.search is empty at build time: a tiny script
// copies the real query string onto the link in the browser.
import { getLocale, alternatePath, UI } from '~/utils/i18n';

const { class: className = '' } = Astro.props;
const pathname = Astro.url.pathname;
const current = getLocale(pathname);
const other = current === 'fr' ? 'en' : 'fr';
const href = alternatePath(pathname, other) + (Astro.url.search || '');
---

<a
  href={href}
  hreflang={other}
  lang={other}
  data-astro-reload
  data-lang-switch
  aria-label={`${UI[current].language}: ${other === 'en' ? 'English' : 'Français'}`}
  title={other === 'en' ? 'English' : 'Français'}
  class:list={[
    'inline-flex items-center gap-1 px-2.5 py-2 text-sm font-semibold rounded-lg text-muted hover:text-default hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors',
    className,
  ]}
>
  <span class:list={[{ 'text-default': current === 'fr' }]}>FR</span>
  <span aria-hidden="true" class="opacity-40">|</span>
  <span class:list={[{ 'text-default': current === 'en' }]}>EN</span>
</a>

<script is:inline>
  (function () {
    function sync() {
      var q = window.location.search;
      if (!q) return;
      document.querySelectorAll('a[data-lang-switch]').forEach(function (a) {
        var base = a.getAttribute('href').split('?')[0];
        a.setAttribute('href', base + q);
      });
    }
    sync();
    document.addEventListener('astro:after-swap', sync);
  })();
</script>
