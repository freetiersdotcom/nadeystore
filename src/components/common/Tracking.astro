---
// Campaign capture and ad pixels: both run ONLY after the visitor accepted measurement cookies (ConsentBanner).
// Pixel ids come from the admin (Ad tracking > Pixels, served by the API) or, as a fallback, from the build variables
// PUBLIC_META_PIXEL_ID / PUBLIC_TIKTOK_PIXEL_ID. No id = no pixel; the campaign capture still runs.
const meta = import.meta.env.PUBLIC_META_PIXEL_ID || '';
const tiktok = import.meta.env.PUBLIC_TIKTOK_PIXEL_ID || '';
const api = import.meta.env.PUBLIC_MERCHANT_API_URL || '';
---

<script is:inline define:vars={{ meta, tiktok, api }}>
  (function () {
    if (window.__snTracking) return;
    window.__snTracking = true;

    // ── Campaign capture: only after the visitor accepted measurement cookies. Kept 30 days in this browser (last campaign wins),
    //    reported to the API when the cart is created (scripts/ads.ts). Refusing or withdrawing erases it.
    var consent = function () {
      try {
        return localStorage.getItem('sn_consent') === 'granted';
      } catch (e) {
        return false;
      }
    };
    var CLICK = { fbclid: 'fbclid', ttclid: 'ttclid', gclid: 'gclid' };
    function capture() {
      if (!consent()) return;
      try {
        var q = new URLSearchParams(location.search);
        var found = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) {
          if (q.get(k)) found[k] = q.get(k);
        });
        Object.keys(CLICK).forEach(function (k) {
          if (q.get(k) && !found.click_id) {
            found.click_id_type = k;
            found.click_id = q.get(k);
          }
        });
        if (!Object.keys(found).length) return;
        found.landing = location.pathname;
        try {
          if (document.referrer && new URL(document.referrer).host !== location.host) found.referrer = document.referrer;
        } catch (e) {}
        found.at = Date.now();
        localStorage.setItem('sn_attr', JSON.stringify(found));
      } catch (e) {}
    }
    capture();
    document.addEventListener('astro:page-load', capture);
    window.addEventListener('sn:consent', function (e) {
      if (e.detail === 'granted') capture();
    });

    window.snAttribution = function () {
      try {
        var a = JSON.parse(localStorage.getItem('sn_attr') || 'null');
        if (!a || !consent() || Date.now() - Number(a.at) > 30 * 86400000) return null;
        delete a.at;
        return a;
      } catch (e) {
        return null;
      }
    };

    // ── Event queue: snTrack('Purchase', {...}, eventId) works before/after consent and before the pixels are ready ──
    //    eventId (the order id for a purchase) lets Meta/TikTok count the browser event and the server event once.
    var loaded = false;
    var started = false;
    var ids = { meta: meta, tiktok: tiktok };
    var queue = [];
    window.snTrack = function (name, params, eventId) {
      if (!loaded) {
        queue.push([name, params, eventId]);
        return;
      }
      send(name, params, eventId);
    };

    function send(name, p, eid) {
      p = p || {};
      try {
        if (window.fbq) window.fbq('track', name, p, eid ? { eventID: String(eid) } : undefined);
      } catch (e) {}
      try {
        if (window.ttq) {
          var map = {
            ViewContent: 'ViewContent',
            AddToCart: 'AddToCart',
            InitiateCheckout: 'InitiateCheckout',
            Purchase: 'CompletePayment',
            Lead: 'Contact',
          };
          window.ttq.track(map[name] || name, p, eid ? { event_id: String(eid) } : undefined);
        }
      } catch (e) {}
    }

    // Pixel ids: build variables first, otherwise ask the API (cached for the session). Never blocks the shop.
    function getIds() {
      if (ids.meta || ids.tiktok || !api) return Promise.resolve(ids);
      try {
        var c = JSON.parse(sessionStorage.getItem('sn_pix') || 'null');
        if (c) return Promise.resolve({ meta: c.meta_pixel_id || '', tiktok: c.tiktok_pixel_id || '' });
      } catch (e) {}
      var ctl = typeof AbortController === 'function' ? new AbortController() : null;
      if (ctl) setTimeout(function () { ctl.abort(); }, 4000);
      return fetch(api + '/m/ads/config', ctl ? { signal: ctl.signal } : undefined)
        .then(function (r) { return r.ok ? r.json() : {}; })
        .then(function (j) {
          try { sessionStorage.setItem('sn_pix', JSON.stringify(j || {})); } catch (e) {}
          return { meta: (j && j.meta_pixel_id) || '', tiktok: (j && j.tiktok_pixel_id) || '' };
        })
        .catch(function () { return ids; });
    }

    function load() {
      if (started) return;
      started = true;
      getIds().then(function (found) {
        ids = found;
        init();
      });
    }

    function init() {
      var meta = ids.meta;
      var tiktok = ids.tiktok;
      loaded = true;
      if (meta) {
        !(function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = !0;
          n.version = '2.0';
          n.queue = [];
          t = b.createElement(e);
          t.async = !0;
          t.src = v;
          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', meta);
        window.fbq('track', 'PageView');
      }
      if (tiktok) {
        !(function (w, d, t) {
          w.TiktokAnalyticsObject = t;
          var ttq = (w[t] = w[t] || []);
          ((ttq.methods = [
            'page',
            'track',
            'identify',
            'instances',
            'debug',
            'on',
            'off',
            'once',
            'ready',
            'alias',
            'group',
            'enableCookie',
            'disableCookie',
          ]),
            (ttq.setAndDefer = function (t, e) {
              t[e] = function () {
                t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
              };
            }));
          for (var i = 0; i < ttq.methods.length; i++) ttq.setAndDefer(ttq, ttq.methods[i]);
          ttq.load = function (e) {
            var n = 'https://analytics.tiktok.com/i18n/pixel/events.js';
            ((ttq._i = ttq._i || {}),
              (ttq._i[e] = []),
              (ttq._i[e]._u = n),
              (ttq._t = ttq._t || {}),
              (ttq._t[e] = +new Date()),
              (ttq._o = ttq._o || {}));
            var o = document.createElement('script');
            ((o.type = 'text/javascript'), (o.async = !0), (o.src = n + '?sdkid=' + e + '&lib=' + t));
            var a = document.getElementsByTagName('script')[0];
            a.parentNode.insertBefore(o, a);
          };
          ttq.load(tiktok);
          ttq.page();
        })(window, document, 'ttq');
      }
      queue.splice(0).forEach(function (x) {
        send(x[0], x[1], x[2]);
      });
    }

    var c = null;
    try {
      c = localStorage.getItem('sn_consent');
    } catch (e) {}
    if (c === 'granted') load();
    window.addEventListener('sn:consent', function (e) {
      if (e.detail === 'granted') load();
    });
  })();
</script>
