---
// src/components/store/EmailModal.astro
// Shown once when the user clicks "Passer la commande" on the cart page.
// Returns a Promise<string | null> via window.promptEmail().
// Mobile: bottom sheet pinned to the visual viewport (keyboard-safe).
// Desktop (sm+): centered card.
---

<div
  id="email-modal"
  class="fixed inset-x-0 top-0 z-50 bg-black/70 backdrop-blur-sm items-end sm:items-center justify-center"
  style="display:none; height:100dvh;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="email-modal-title"
>
  <div
    id="email-modal-card"
    class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 w-full sm:max-w-sm sm:mx-4 rounded-t-2xl sm:rounded-2xl p-6 shadow-2xl"
    style="padding-bottom: calc(1.5rem + env(safe-area-inset-bottom));"
  >
    <h2 id="email-modal-title" class="text-lg font-semibold mb-1 text-default">Presque là</h2>
    <p class="text-muted text-sm mb-4">
      Entrez votre adresse e-mail pour finaliser votre commande. Votre confirmation y sera envoyée.
    </p>
    <input
      id="modal-email"
      type="email"
      inputmode="email"
      enterkeyhint="done"
      placeholder="vous@exemple.com"
      autocomplete="email"
      autocapitalize="off"
      autocorrect="off"
      class="w-full bg-gray-50 dark:bg-slate-800 border border-gray-300 dark:border-slate-600 rounded-lg px-4 py-3 text-default placeholder-muted focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary mb-2"
      style="font-size:16px;"
    />
    <p id="modal-error" class="text-red-500 text-xs mb-3" style="display:none">
      Veuillez entrer une adresse e-mail valide.
    </p>
    <div class="flex gap-2 mt-2">
      <button
        id="modal-cancel"
        type="button"
        class="flex-1 px-4 py-3 text-sm text-muted hover:text-default transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-slate-800"
      >
        Annuler
      </button>
      <button id="modal-confirm" type="button" class="flex-1 btn-primary py-3 px-4 text-sm rounded-lg">
        Continuer
      </button>
    </div>
  </div>
</div>

<script>
  // window.promptEmail() — returns Promise<string | null>
  // null means the user cancelled.
  // Note: font-size 16px on the input prevents iOS Safari from zooming on focus.
  // The overlay height follows the visual viewport so the sheet stays above the keyboard.
  window.promptEmail = function (): Promise<string | null> {
    return new Promise((resolve) => {
      const modal = document.getElementById('email-modal')!;
      const input = document.getElementById('modal-email') as HTMLInputElement;
      const confirm = document.getElementById('modal-confirm')!;
      const cancel = document.getElementById('modal-cancel')!;
      const errorEl = document.getElementById('modal-error')!;
      const vv = window.visualViewport;

      function fitViewport() {
        if (!vv) return;
        modal.style.height = `${vv.height}px`;
        modal.style.top = `${vv.offsetTop}px`;
      }

      const prevOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      modal.style.display = 'flex';
      fitViewport();
      vv?.addEventListener('resize', fitViewport);
      vv?.addEventListener('scroll', fitViewport);

      input.value = '';
      errorEl.style.display = 'none';
      setTimeout(() => input.focus(), 50);

      function onConfirm() {
        const email = input.value.trim();
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          errorEl.style.display = 'block';
          return;
        }
        cleanup();
        resolve(email);
      }

      function onCancel() {
        cleanup();
        resolve(null);
      }

      function onKey(e: KeyboardEvent) {
        if (e.key === 'Enter') {
          e.preventDefault();
          onConfirm();
        }
        if (e.key === 'Escape') onCancel();
      }

      function onBackdrop(e: MouseEvent) {
        if (e.target === modal) onCancel();
      }

      function cleanup() {
        modal.style.display = 'none';
        modal.style.height = '100dvh';
        modal.style.top = '0';
        document.body.style.overflow = prevOverflow;
        vv?.removeEventListener('resize', fitViewport);
        vv?.removeEventListener('scroll', fitViewport);
        confirm.removeEventListener('click', onConfirm);
        cancel.removeEventListener('click', onCancel);
        input.removeEventListener('keydown', onKey);
        modal.removeEventListener('click', onBackdrop);
      }

      confirm.addEventListener('click', onConfirm);
      cancel.addEventListener('click', onCancel);
      input.addEventListener('keydown', onKey);
      modal.addEventListener('click', onBackdrop);
    });
  };

  declare global {
    interface Window {
      promptEmail: () => Promise<string | null>;
    }
  }
</script>
