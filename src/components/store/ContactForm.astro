---
// Contact form wired to POST /v1/submissions.
// <ContactForm locale="fr" />  or  <ContactForm locale="en" />
// Optional env: PUBLIC_TURNSTILE_SITEKEY (Cloudflare Turnstile widget key).
import type { Locale } from '~/utils/i18n';
import { page } from '~/utils/i18n';

export interface Props {
  locale: Locale;
  id?: string;
}
const { locale, id = 'form' } = Astro.props;
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '';

const T = {
  fr: {
    title: 'Envoyez-nous un message',
    subtitle: 'Remplissez ce formulaire et nous vous répondrons dans les plus brefs délais.',
    name: 'Nom complet',
    namePh: 'Votre nom',
    email: 'Adresse e-mail',
    emailPh: 'vous@exemple.com',
    phone: 'WhatsApp / téléphone (facultatif)',
    phonePh: '+229 …',
    message: 'Message',
    messagePh: 'Décrivez votre question ou votre demande...',
    send: 'Envoyer le message',
    sending: 'Envoi…',
    need: 'Indiquez une adresse e-mail ou un numéro WhatsApp pour que nous puissions vous répondre.',
    ok: 'Merci ! Votre message a bien été envoyé. Nous vous répondons dès que possible.',
    fail: "Le message n'a pas pu être envoyé. Réessayez, ou écrivez-nous sur WhatsApp.",
    limit: 'Trop de messages envoyés. Réessayez plus tard ou écrivez-nous sur WhatsApp.',
    captcha: 'La vérification anti-spam a échoué. Rechargez la page et réessayez.',
    privacy: 'Vos informations ne seront jamais partagées avec des tiers. Consultez notre',
    privacyLink: 'politique de confidentialité',
  },
  en: {
    title: 'Send us a message',
    subtitle: 'Fill in this form and we will reply as soon as possible.',
    name: 'Full name',
    namePh: 'Your name',
    email: 'Email address',
    emailPh: 'you@example.com',
    phone: 'WhatsApp / phone (optional)',
    phonePh: '+229 …',
    message: 'Message',
    messagePh: 'Describe your question or request...',
    send: 'Send message',
    sending: 'Sending…',
    need: 'Please give an email address or a WhatsApp number so we can reply.',
    ok: 'Thank you! Your message has been sent. We will reply as soon as possible.',
    fail: 'Your message could not be sent. Please try again, or write to us on WhatsApp.',
    limit: 'Too many messages sent. Please try again later or write to us on WhatsApp.',
    captcha: 'The spam check failed. Please reload the page and try again.',
    privacy: 'Your information will never be shared with third parties. See our',
    privacyLink: 'privacy policy',
  },
}[locale];
const input =
  'py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900';
---

<section id={id} class="px-4 py-12 sm:px-6 mx-auto max-w-7xl">
  <div class="max-w-xl mx-auto text-center mb-8">
    <h2 class="text-3xl font-bold font-heading tracking-tight">{T.title}</h2>
    <p class="mt-3 text-muted">{T.subtitle}</p>
  </div>

  <div
    class="flex flex-col max-w-xl mx-auto rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shadow p-4 sm:p-6 lg:p-8 w-full"
  >
    <form id="sn-contact-form" data-locale={locale} data-sitekey={sitekey} novalidate>
      <div class="mb-5">
        <label for="cf-name" class="block text-sm font-medium">{T.name}</label>
        <input
          id="cf-name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder={T.namePh}
          maxlength="120"
          class={input}
        />
      </div>
      <div class="mb-5">
        <label for="cf-email" class="block text-sm font-medium">{T.email}</label>
        <input
          id="cf-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder={T.emailPh}
          maxlength="200"
          class={input}
        />
      </div>
      <div class="mb-5">
        <label for="cf-phone" class="block text-sm font-medium">{T.phone}</label>
        <input
          id="cf-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          placeholder={T.phonePh}
          maxlength="40"
          class={input}
        />
      </div>
      <div class="mb-5">
        <label for="cf-message" class="block text-sm font-medium">{T.message}</label>
        <textarea
          id="cf-message"
          name="message"
          rows="6"
          placeholder={T.messagePh}
          maxlength="4000"
          required
          class={input}></textarea>
      </div>

      <!-- Honeypot: hidden from people, bots fill it -->
      <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden">
        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      {sitekey && <div id="cf-turnstile" class="mb-5" />}

      <p id="cf-status" role="status" aria-live="polite" class="text-sm mb-4 hidden"></p>

      <button
        type="submit"
        id="cf-submit"
        class="btn-primary w-full py-3 px-6 rounded-lg font-semibold disabled:opacity-60"
        data-label={T.send}
        data-sending={T.sending}>{T.send}</button
      >

      <p class="mt-4 text-xs text-muted">
        {T.privacy}
        <a href={page('privacy', locale)} class="text-primary hover:underline">{T.privacyLink}</a>.
      </p>
    </form>
  </div>
</section>

<script is:inline define:vars={{ MSG: { need: T.need, ok: T.ok, fail: T.fail, limit: T.limit, captcha: T.captcha } }}>
  window.__snMsg = MSG;
</script>

<script>
  import { apiUrl, publicKey } from '~/scripts/api';

  declare global {
    interface Window {
      turnstile?: any;
      __snMsg?: Record<string, string>;
      __snTsLoading?: boolean;
      snTrack?: (n: string, p?: any) => void;
      snAttribution?: () => Record<string, string> | null;
    }
  }

  let tsWidget: string | null = null;
  let tsToken = '';

  function mountTurnstile(form: HTMLFormElement) {
    const sitekey = form.dataset.sitekey;
    const holder = document.getElementById('cf-turnstile');
    if (!sitekey || !holder) return;
    const render = () => {
      if (!window.turnstile || holder.childElementCount) return;
      tsWidget = window.turnstile.render(holder, {
        sitekey,
        callback: (t: string) => (tsToken = t),
        'expired-callback': () => (tsToken = ''),
        'error-callback': () => (tsToken = ''),
      });
    };
    if (window.turnstile) return render();
    if (!window.__snTsLoading) {
      window.__snTsLoading = true;
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = render;
      document.head.appendChild(s);
    } else {
      const t = setInterval(() => {
        if (window.turnstile) {
          clearInterval(t);
          render();
        }
      }, 200);
    }
  }

  function init() {
    const form = document.getElementById('sn-contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    mountTurnstile(form);

    const status = document.getElementById('cf-status')!;
    const btn = document.getElementById('cf-submit') as HTMLButtonElement;
    const msg = window.__snMsg || {};
    const show = (text: string, ok: boolean) => {
      status.textContent = text;
      status.className = `text-sm mb-4 ${ok ? 'text-green-700' : 'text-red-600'}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      const phone = String(fd.get('phone') || '').trim();
      if (!email && !phone) return show(msg.need, false);
      if (!form.reportValidity()) return;

      btn.disabled = true;
      btn.textContent = btn.dataset.sending || '…';
      try {
        const res = await fetch(`${apiUrl()}/v1/submissions`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${publicKey()}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({
            form: 'contact',
            name: String(fd.get('name') || '').trim() || undefined,
            email: email || undefined,
            phone: phone || undefined,
            message: String(fd.get('message') || '').trim(),
            locale: form.dataset.locale,
            page: location.pathname,
            source: window.snAttribution?.() || undefined,
            website: String(fd.get('website') || ''),
            turnstile_token: tsToken || undefined,
          }),
        });
        if (res.ok) {
          show(msg.ok, true);
          form.reset();
          window.snTrack?.('Lead', { content_name: 'contact_form' });
        } else {
          const data: any = await res.json().catch(() => ({}));
          const code = data?.error?.code;
          show(code === 'rate_limit_exceeded' ? msg.limit : code === 'captcha_failed' ? msg.captcha : msg.fail, false);
        }
      } catch {
        show(msg.fail, false);
      } finally {
        btn.disabled = false;
        btn.textContent = btn.dataset.label || '';
        if (tsWidget && window.turnstile) {
          tsToken = '';
          try {
            window.turnstile.reset(tsWidget);
          } catch {}
        }
      }
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
