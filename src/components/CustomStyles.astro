---
// Fonts and colours of the site. The colours come from the theme chosen in src/site.config.ts (see src/themes.ts).
import '@fontsource-variable/inter';
import { site } from '~/site.config';
import { themeCss } from '~/themes';

// To use another font, install its @fontsource package, import it here and use its name in src/themes.ts:
// 'DM Sans', Nunito, Dosis, Outfit, Roboto, Literata, 'IBM Plex Sans', Karla, Poppins, 'Fira Sans', 'Libre Franklin',
// Inconsolata, Raleway, Oswald, 'Space Grotesk', Urbanist
const css = themeCss(site.theme);
---

<style is:inline set:html={css}></style>
