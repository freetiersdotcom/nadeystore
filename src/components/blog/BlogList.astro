---
// Blog list for one page of results. Used by /fr/blog, /en/blog and their /page/N routes.
import type { Locale } from '~/utils/i18n';
import { BLOG_UI, blogPagePath, formatDate, type BlogPost } from '~/utils/posts';

export interface Props {
  lang: Locale;
  posts: BlogPost[];
  page: number;
  totalPages: number;
}

const { lang, posts, page, totalPages } = Astro.props;
const t = BLOG_UI[lang];
---

<section class="px-4 py-12 sm:px-6 mx-auto max-w-6xl lg:py-16">
  <header class="max-w-3xl mb-10 md:mb-14">
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">{t.title}</h1>
    <p class="mt-4 text-xl text-muted">{t.description}</p>
  </header>

  {
    posts.length === 0 ? (
      <p class="text-lg text-muted">{t.empty}</p>
    ) : (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="flex flex-col rounded-lg shadow-lg bg-white dark:bg-slate-900 overflow-hidden">
            {post.image && (
              <a href={post.path} tabindex="-1" aria-hidden="true">
                <img
                  src={post.image}
                  alt=""
                  width="800"
                  height="450"
                  loading="lazy"
                  decoding="async"
                  class="w-full aspect-video object-cover bg-gray-200 dark:bg-slate-800"
                />
              </a>
            )}
            <div class="flex flex-col flex-1 p-5">
              <p class="text-sm text-muted">
                <time datetime={post.publishDate.toISOString()}>{formatDate(post.publishDate, lang)}</time>
                {post.category && <span> · {post.category}</span>}
              </p>
              <h2 class="mt-2 text-xl font-semibold leading-snug font-heading">
                <a href={post.path} class="hover:underline">{post.title}</a>
              </h2>
              {post.excerpt && <p class="mt-3 text-muted flex-1">{post.excerpt}</p>}
              <a href={post.path} class="mt-4 font-medium text-primary hover:underline">{t.readMore}</a>
            </div>
          </article>
        ))}
      </div>
    )
  }

  {
    totalPages > 1 && (
      <nav class="mt-12 flex items-center justify-between" aria-label="Pagination">
        {page > 1 ? <a href={blogPagePath(lang, page - 1)} class="font-medium text-primary hover:underline">{t.newer}</a> : <span />}
        <span class="text-sm text-muted">{t.pageOf(page, totalPages)}</span>
        {page < totalPages ? <a href={blogPagePath(lang, page + 1)} class="font-medium text-primary hover:underline">{t.older}</a> : <span />}
      </nav>
    )
  }
</section>
