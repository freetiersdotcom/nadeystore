---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Santé Natur’ — Produits naturels de bien-être, livrés chez vous',
  description:
    'Tisanes, miels, huiles naturelles, savons, parfums, encens et produits de bien-être soigneusement sélectionnés. Boutique en ligne basée à Cotonou, livraison au Bénin et dans la diaspora.',
};
---

<Layout metadata={metadata}>
  <!-- ── Hero ──────────────────────────────────────────────── -->
  <Hero2
    tagline="Produits naturels · Cotonou, Bénin"
    title="La puissance de la nature <span class='text-accent dark:text-accent highlight'>au service de votre bien-être</span>"
    subtitle="Tisanes, miels, huiles naturelles, savons, parfums, encens et produits de bien-être, soigneusement sélectionnés et livrés chez vous, au Bénin comme dans la diaspora."
    actions={[
      { variant: 'primary', text: 'Commandez maintenant', href: '/fr/boutique', icon: 'tabler:shopping-cart' },
      { text: 'Nous écrire sur WhatsApp', href: 'https://wa.me/2290194458956', icon: 'tabler:brand-whatsapp' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1472141341085-dab5ea0df9a2?q=80&w=872',
      alt: 'Plantes et produits naturels',
    }}
  />

  <!-- ── Trust strip ────────────────────────────────────────── -->
  <Features
    id="avantages"
    tagline="Pourquoi nous choisir"
    title="Des produits et un service en qui vous pouvez avoir confiance"
    subtitle="Une sélection soignée, un paiement sécurisé et une équipe qui vous accompagne jusqu'à votre satisfaction."
    columns={4}
    items={[
      {
        title: 'Sélection soignée',
        description: 'Des produits naturels de qualité premium, dont les ingrédients sont choisis avec soin.',
        icon: 'tabler:leaf',
      },
      {
        title: 'Paiement sécurisé',
        description:
          'Réglez en ligne par Mobile Money ou carte bancaire (Visa, Mastercard) via des prestataires de paiement sécurisés.',
        icon: 'tabler:lock',
      },
      {
        title: 'Livraison garantie',
        description:
          'Nous livrons au Bénin, dans la région et auprès de la diaspora. Les frais sont calculés avant le paiement.',
        icon: 'tabler:truck-delivery',
      },
      {
        title: 'Service client réactif',
        description:
          'Une question ? Écrivez-nous par WhatsApp ou par e-mail : nous vous répondons et vous expliquons clairement chaque produit.',
        icon: 'tabler:message-circle',
      },
    ]}
  />

  <!-- ── What we offer ──────────────────────────────────────── -->
  <Content
    id="produits"
    tagline="Notre boutique"
    title="Ce que vous trouverez chez nous"
    subtitle="Une gamme pensée pour accompagner votre quotidien."
    isReversed
    items={[
      {
        title: 'Tisanes et thés',
        description: 'Des infusions et des thés à découvrir pour vos moments de détente au quotidien.',
        icon: 'tabler:cup',
      },
      {
        title: 'Miels et huiles naturelles',
        description: 'Des produits naturels pour la table et pour le soin, sélectionnés avec attention.',
        icon: 'tabler:droplet',
      },
      {
        title: 'Savons, parfums et encens',
        description: 'Des créations pour prendre soin de vous et de votre intérieur.',
        icon: 'tabler:flower',
      },
      {
        title: 'Livres numériques',
        description: 'Des ebooks à télécharger immédiatement après votre paiement.',
        icon: 'tabler:book',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1508014861016-f37cdf89e94d?q=80&w=654',
      alt: 'Produits naturels de bien-être',
    }}
    callToAction={{
      text: 'Voir tous les produits',
      href: '/fr/boutique',
      icon: 'tabler:arrow-right',
    }}
  />

  <!-- ── About strip ────────────────────────────────────────── -->
  <Content
    tagline="Qui sommes-nous"
    title="Une boutique au service de votre bien-être"
    content={`
      <p>Santé Natur’ est une boutique en ligne basée à Cotonou, au Bénin. Nous proposons des produits naturels et de bien-être, soigneusement présentés et sélectionnés pour vous accompagner dans votre quotidien.</p>
      <p class="mt-4">Notre clientèle : toute personne en quête de produits naturels, les personnes intéressées par la spiritualité africaine, la diaspora africaine et les entrepreneurs du bien-être.</p>
      <p class="mt-4 font-medium">Notre engagement : un suivi attentif, de votre commande jusqu'à votre entière satisfaction.</p>
    `}
    items={[
      {
        title: 'Des produits expliqués',
        description: 'Fiches produits détaillées et, selon les produits, vidéos de présentation.',
        icon: 'tabler:video',
      },
      {
        title: 'Un suivi rigoureux',
        description: 'Nous restons à votre écoute avant, pendant et après votre commande.',
        icon: 'tabler:heart-handshake',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?w=800&q=80',
      alt: 'Plantes et ingrédients naturels',
    }}
    callToAction={{
      text: 'En savoir plus',
      href: '/a-propos',
      icon: 'tabler:arrow-right',
    }}
  />

  <!-- ── How it works ───────────────────────────────────────── -->
  <Steps
    id="comment-ca-marche"
    tagline="Simple et rapide"
    title="Commander en 3 étapes"
    items={[
      {
        title: 'Parcourez la boutique',
        description:
          'Explorez nos produits. Chaque fiche présente le produit, ses options et, selon les cas, une vidéo de présentation.',
        icon: 'tabler:search',
      },
      {
        title: 'Passez votre commande',
        description:
          'Ajoutez vos produits au panier, renseignez votre adresse de livraison et payez en ligne en toute sécurité, par Mobile Money ou carte bancaire.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Recevez votre commande',
        description:
          'Vous recevez une confirmation par e-mail. Notre équipe reste joignable sur WhatsApp pour le suivi de votre commande.',
        icon: 'tabler:package',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=800&q=80',
      alt: "Colis prêt à l'expédition",
    }}
  />

  <!-- Customer reviews: add a Testimonials section here once real reviews have been collected. -->

  <!-- ── Final CTA ──────────────────────────────────────────── -->
  <CallToAction
    tagline="Prêt à commander ?"
    title="Découvrez la boutique"
    subtitle="Livraison garantie. Une question avant de commander ? Écrivez-nous sur WhatsApp, nous vous répondons rapidement."
    actions={[
      { variant: 'primary', text: 'Commandez maintenant', href: '/fr/boutique', icon: 'tabler:shopping-cart' },
      { text: 'WhatsApp', href: 'https://wa.me/2290194458956', icon: 'tabler:brand-whatsapp' },
    ]}
  />
</Layout>
