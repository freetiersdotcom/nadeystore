---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'À propos — Santé Natur’',
  description:
    "Santé Natur’ est une boutique en ligne basée à Cotonou, Bénin : produits naturels et de bien-être, soigneusement sélectionnés, pour le Bénin, l'Afrique de l'Ouest et la diaspora.",
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Qui sommes-nous"
    title="La puissance de la nature au service de votre bien-être"
    subtitle="Santé Natur’ est une boutique en ligne basée à Cotonou, au Bénin. Nous proposons des produits naturels et de bien-être, soigneusement présentés et sélectionnés pour accompagner nos clients au quotidien."
  />

  <!-- ── What we do ──────────────────────────────────────────── -->
  <Content
    tagline="Notre activité"
    title="Des produits naturels, simplement expliqués"
    content={`
      <p>Nous proposons notamment des tisanes, des miels, des huiles naturelles, des savons, des parfums, de l'encens et des produits de bien-être, ainsi que des livres numériques.</p>
      <p class="mt-4">Notre objectif : vous permettre de découvrir, de comprendre et de commander facilement des produits naturels de qualité, où que vous soyez. C'est pourquoi chaque produit est accompagné d'une présentation claire et, selon les cas, d'une vidéo explicative.</p>
    `}
    isReversed
    image={{
      src: 'https://images.unsplash.com/photo-1605020420620-20c943cc4669?w=800&q=80',
      alt: 'Plantes et produits naturels',
    }}
  />

  <!-- ── Who we serve ────────────────────────────────────────── -->
  <Content
    tagline="Nos clients"
    title="Une boutique pour toutes celles et ceux qui cherchent le naturel"
    content={`
      <p>Nous nous adressons à toute personne en quête de produits naturels, au Bénin, en Afrique de l'Ouest et centrale, ainsi qu'à la diaspora africaine en Europe, en Amérique et ailleurs.</p>
      <p class="mt-4">Parmi nos clients : des personnes intéressées par la spiritualité africaine, des familles à la recherche de produits du quotidien, et des entrepreneurs du bien-être.</p>
    `}
    items={[
      {
        title: 'Au Bénin et dans la région',
        description: "Commandez depuis Cotonou ou depuis un autre pays d'Afrique de l'Ouest.",
        icon: 'tabler:map-pin',
      },
      {
        title: 'Dans la diaspora',
        description: "Nous livrons aussi vers l'Europe, l'Amérique du Nord et d'autres destinations.",
        icon: 'tabler:world',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=800&q=80',
      alt: 'Plantes et feuillages naturels',
    }}
  />

  <!-- ── Commitments ─────────────────────────────────────────── -->
  <Features2
    tagline="Nos engagements"
    title="Ce que vous pouvez attendre de nous"
    subtitle="Des principes simples, appliqués à chaque commande."
    items={[
      {
        title: 'Une sélection soignée',
        description:
          'Nous choisissons nos produits et leurs ingrédients avec attention, dans un esprit de qualité premium.',
        icon: 'tabler:award',
      },
      {
        title: 'Des explications claires',
        description:
          'Chaque produit est présenté en détail et, selon les cas, en vidéo. Une question ? Nous vous répondons.',
        icon: 'tabler:video',
      },
      {
        title: 'Un paiement sécurisé',
        description: 'Réglez en ligne par Mobile Money ou carte bancaire, via des prestataires de paiement sécurisés.',
        icon: 'tabler:lock',
      },
      {
        title: 'Une livraison garantie',
        description:
          "Nous suivons votre commande jusqu'à sa réception. En cas de problème, contactez-nous : nous cherchons une solution avec vous.",
        icon: 'tabler:truck-delivery',
      },
      {
        title: 'Un service client réactif',
        description: 'Notre équipe vous répond par WhatsApp ou par e-mail, avant comme après votre achat.',
        icon: 'tabler:message-circle',
      },
      {
        title: "Un suivi jusqu'à votre satisfaction",
        description: "Nous restons à votre écoute jusqu'à ce que vous soyez pleinement satisfait de votre commande.",
        icon: 'tabler:heart-handshake',
      },
    ]}
  />

  <!-- ── CTA ─────────────────────────────────────────────────── -->
  <CallToAction
    tagline="Bienvenue"
    title="Découvrez Santé Natur’"
    subtitle="Parcourez la boutique ou écrivez-nous : nous sommes là pour vous conseiller."
    actions={[
      { variant: 'primary', text: 'Commandez maintenant', href: '/fr/boutique', icon: 'tabler:shopping-cart' },
      { text: 'Nous contacter', href: '/contact' },
    ]}
  />
</Layout>
