---
// src/pages/en/products/[slug].astro
// Individual product page. Two modes, chosen at build time by the
// PRODUCT_PAGES_MODE variable (see the `product-pages-mode` integration in astro.config.ts):
//
//   ssr    (default) rendered on demand — product edits, new products and stock
//          changes show up within ~30 s, no rebuild needed (see src/utils/catalog.ts).
//   static prerendered at build time — fastest, but needs a rebuild to pick up
//          changes (the API triggers one through a deploy hook, see REBUILD_HOOK_URL).

import StoreLayout from '~/layouts/StoreLayout.astro';
import ProductVideo from '~/components/store/ProductVideo.astro';
import type { Product } from '~/scripts/api';
import { getActiveProducts, findProductBySlug, getRelatedProducts } from '~/utils/catalog';

// Default is on-demand; astro.config.ts overrides this to `true` in static mode.
export const prerender = false;

// Only used when the page is prerendered (static mode); ignored in ssr mode.
export async function getStaticPaths() {
  const products = await getActiveProducts();
  return products.map((product) => ({
    params: { slug: product.slug || product.id },
    props: { product, related: getRelatedProducts(products, product) },
  }));
}

let product: Product | undefined = Astro.props.product;
let related: Product[] = Astro.props.related ?? [];

if (!product) {
  // ssr mode: look the product up now.
  let products: Product[];
  try {
    products = await getActiveProducts();
  } catch (e) {
    console.error('[product page] Could not load catalog', e);
    return new Response('The shop is temporarily unavailable. Please try again in a moment.', {
      status: 503,
      headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Retry-After': '30' },
    });
  }
  product = findProductBySlug(products, Astro.params.slug);
  if (!product) {
    return Astro.rewrite('/404');
  }
  related = getRelatedProducts(products, product);
}

// English page: prefer the English description, fall back to the default one.
const description = product.description_en || product.description;

const defaultVariant = product.variants[0];
const isDigital = (defaultVariant.product_type || 'physical') === 'digital';
const isService = (defaultVariant.product_type || 'physical') === 'service';
const mainImage =
  defaultVariant.image_url || product.image_url || 'https://placehold.co/600x600/f4f4f5/a1a1aa?text=Image';

const metadata = {
  title: product.title,
  description: description ?? undefined,
};
---

<StoreLayout metadata={metadata} cartUrl="/en/cart">
  <!-- Breadcrumb -->
  <nav class="max-w-6xl mx-auto px-6 pt-6 pb-2 text-sm text-muted flex gap-2">
    <a href="/en/" class="hover:text-default transition-colors">Home</a>
    <span>/</span>
    <a href="/en/shop" class="hover:text-default transition-colors">Shop</a>
    <span>/</span>
    <span class="text-default">{product.title}</span>
  </nav>

  <!-- Product section -->
  <section class="max-w-6xl mx-auto px-6 py-8">
    <div class="grid md:grid-cols-2 gap-12">
      <!-- Images -->
      <div>
        <div class="aspect-square bg-gray-100 dark:bg-slate-800 rounded-2xl overflow-hidden mb-3">
          <img id="main-image" src={mainImage} alt={product.title} class="w-full h-full object-cover" loading="eager" />
        </div>
        <!-- Variant images thumbnails (filled by JS when variant selected) -->
        <div id="variant-thumbs" class="flex gap-2 flex-wrap"></div>
      </div>

      <!-- Info -->
      <div class="flex flex-col">
        <div class="flex gap-2 mb-3">
          {
            isDigital && (
              <span class="bg-accent/10 text-accent text-xs font-medium px-2.5 py-1 rounded-full">
                ⚡ Digital download
              </span>
            )
          }
          {
            isService && (
              <span class="bg-primary/10 text-primary text-xs font-medium px-2.5 py-1 rounded-full">Service</span>
            )
          }
          {
            (product.tags ?? []).map((tag) => (
              <span class="bg-gray-100 dark:bg-slate-800 text-muted text-xs px-2.5 py-1 rounded-full">{tag}</span>
            ))
          }
        </div>

        <h1 class="font-bold font-heading text-3xl md:text-4xl tracking-tight mb-3">
          {product.title}
        </h1>

        <p id="product-price" class="text-2xl font-semibold text-default mb-4">
          — {/* filled by JS */}
        </p>

        {
          description && (
            <div class="prose dark:prose-invert prose-sm max-w-none mb-6 text-muted">
              <p>{description}</p>
            </div>
          )
        }

        <!-- Variant selector -->
        {
          product.variants.length > 1 && (
            <div class="mb-5">
              <label class="block text-sm font-medium text-default mb-2">Option</label>
              <select
                id="variant-select"
                class="w-full bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg px-4 py-2.5 text-sm text-default focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
              >
                {product.variants.map((v) => (
                  <option
                    value={v.sku}
                    data-price={v.price_cents}
                    data-type={v.product_type || 'physical'}
                    data-image={v.image_url || ''}
                    data-title={v.title}
                    data-in-stock={v.in_stock}
                  >
                    {v.title}
                    {!v.in_stock ? ' (out of stock)' : ''}
                  </option>
                ))}
              </select>
            </div>
          )
        }

        <button
          id="add-to-cart"
          type="button"
          class="btn-primary py-3.5 px-8 text-base rounded-xl font-semibold mb-4 disabled:opacity-50 disabled:cursor-not-allowed"
          data-sku={defaultVariant.sku}
          data-price={defaultVariant.price_cents}
          data-product-type={defaultVariant.product_type || 'physical'}
          data-variant-title={defaultVariant.title}
          data-image={defaultVariant.image_url || ''}
          disabled={!defaultVariant.in_stock}
        >
          {defaultVariant.in_stock ? (isDigital ? 'Buy now' : isService ? 'Book now' : 'Add to cart') : 'Out of stock'}
        </button>

        <p class="text-xs text-muted mb-6">
          {
            isDigital
              ? 'Download link sent by email after payment.'
              : isService
                ? 'After payment, we will contact you to agree on the date and arrangements for your session.'
                : 'Delivery fees are calculated in the cart before payment.'
          }
        </p>

        <!-- Trust signals -->
        <div class="border-t border-gray-100 dark:border-slate-800 pt-5 grid grid-cols-2 gap-3 text-xs text-muted">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
              ><path
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path></svg
            >
            Secure payment
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
              ><path
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path></svg
            >
            Email confirmation
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
              ><path
                d="M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14V5a2 2 0 00-2-2H6a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z"
              ></path></svg
            >
            Returns and refunds
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
              ><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
            >
            Delivery to Benin & the diaspora
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product video (optional) -->
  {
    product.video_url && (
      <section class="max-w-6xl mx-auto px-6 pb-12">
        <h2 class="font-bold font-heading text-2xl mb-6">Watch the product video</h2>
        <ProductVideo url={product.video_url} title={product.title} />
      </section>
    )
  }

  <!-- Related products -->
  {
    related.length > 0 && (
      <section class="max-w-6xl mx-auto px-6 py-12 border-t border-gray-100 dark:border-slate-800">
        <h2 class="font-bold font-heading text-2xl mb-6">You may also like</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {related.map((rp) => {
            const rv = rp.variants[0];
            const rImg = rv.image_url || rp.image_url || 'https://placehold.co/300x300/f4f4f5/a1a1aa?text=Image';
            const rSlug = rp.slug || rp.id;
            return (
              <a href={`/en/products/${rSlug}`} class="group block">
                <div class="aspect-square bg-gray-100 dark:bg-slate-800 rounded-xl overflow-hidden mb-3">
                  <img
                    src={rImg}
                    alt={rp.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
                <p class="font-medium text-sm text-default group-hover:text-primary transition-colors">{rp.title}</p>
                <p class="text-xs text-muted mt-0.5">
                  {/* Price rendered by JS to avoid SSG currency mismatch */}
                  <span data-price={rv.price_cents} data-currency class="related-price" />
                </p>
              </a>
            );
          })}
        </div>
      </section>
    )
  }
</StoreLayout>

<script>
  import { addToCart, updateCartBadge, formatPrice } from '~/scripts/cart';
  import { currency as getCurrency } from '~/scripts/api';

  const CURRENCY = getCurrency();

  // Button label per product type (services are paid first, then scheduled).
  function actionLabel(type?: string): string {
    return type === 'digital' ? 'Buy now' : type === 'service' ? 'Book now' : 'Add to cart';
  }

  // ── Hydrate prices ─────────────────────────────────────────
  // Prices are in data attributes to avoid SSG/currency mismatch.

  function hydratePrices() {
    // Main price
    const priceEl = document.getElementById('product-price');
    const btn = document.getElementById('add-to-cart') as HTMLButtonElement | null;
    if (priceEl && btn) {
      priceEl.textContent = formatPrice(Number(btn.dataset.price), CURRENCY);
    }

    // Related product prices
    document.querySelectorAll('.related-price').forEach((el) => {
      const price = Number((el as HTMLElement).dataset.price);
      el.textContent = formatPrice(price, CURRENCY);
    });
  }

  // ── Variant selector ──────────────────────────────────────

  function handleVariantChange(e: Event) {
    const select = e.target as HTMLSelectElement;
    const opt = select.options[select.selectedIndex];
    const btn = document.getElementById('add-to-cart') as HTMLButtonElement;
    const img = document.getElementById('main-image') as HTMLImageElement;

    btn.dataset.sku = select.value;
    btn.dataset.price = opt.dataset.price!;
    btn.dataset.productType = opt.dataset.type!;
    btn.dataset.variantTitle = opt.dataset.title!;
    btn.dataset.image = opt.dataset.image!;

    // Swap main image if variant has one
    if (opt.dataset.image) {
      img.src = opt.dataset.image;
    }

    document.getElementById('product-price')!.textContent = formatPrice(Number(opt.dataset.price), CURRENCY);

    // Reflect the selected variant's stock status
    const inStock = opt.dataset.inStock === 'true';
    btn.disabled = !inStock;
    btn.textContent = inStock ? actionLabel(btn.dataset.productType) : 'Out of stock';
  }

  // ── Add to cart ────────────────────────────────────────────

  function handleAddToCart() {
    const btn = document.getElementById('add-to-cart') as HTMLButtonElement;
    if (btn.disabled) return; // out of stock — nothing to add

    // Inline product title from the page h1
    const title = document.querySelector('h1')?.textContent?.trim() ?? btn.dataset.sku!;

    addToCart({
      sku: btn.dataset.sku!,
      title,
      price_cents: Number(btn.dataset.price),
      product_type: (btn.dataset.productType as 'physical' | 'digital') || 'physical',
      image_url: btn.dataset.image || null,
      variant_title: btn.dataset.variantTitle || '',
    });

    btn.textContent = 'Added ✓';
    btn.classList.add('opacity-75');
    btn.disabled = true;
    setTimeout(() => {
      btn.textContent = actionLabel(btn.dataset.productType);
      btn.classList.remove('opacity-75');
      btn.disabled = false;
    }, 1500);

    window.showCartToast?.(title);
  }

  // ── Init ──────────────────────────────────────────────────
  // Re-run on every load AND after every Astro ClientRouter swap:
  // swapped-in DOM nodes are new elements with no listeners attached yet.

  function initProductPage() {
    hydratePrices();
    updateCartBadge();
    document.getElementById('variant-select')?.addEventListener('change', handleVariantChange);
    document.getElementById('add-to-cart')?.addEventListener('click', handleAddToCart);
  }

  initProductPage();

  document.addEventListener('astro:after-swap', initProductPage);
</script>
