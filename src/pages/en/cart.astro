---
// src/pages/en/cart.astro
// Cart page — renders from localStorage, runs the full checkout pipeline
// (create cart → add items → set shipping → redirect to payment) on submit.
import StoreLayout from '~/layouts/StoreLayout.astro';

const metadata = {
  title: 'Your cart',
};
---

<StoreLayout metadata={metadata} cartUrl="/en/cart" cancelUrl="/en/shop">
  <!-- pb-28 on mobile leaves room for the sticky checkout bar -->
  <div class="max-w-5xl mx-auto px-6 pt-12 pb-28 md:pb-12">
    <h1 class="font-bold font-heading text-3xl mb-8">Your cart</h1>

    <p id="page-error" class="text-red-500 text-sm mb-4" style="display:none"></p>

    <!-- Empty state -->
    <div id="empty-cart" class="text-center py-20" style="display:none">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-gray-100 dark:bg-slate-800 rounded-full mb-4">
        <svg class="w-8 h-8 text-muted" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
      </div>
      <h2 class="text-xl font-medium mb-2">Your cart is empty</h2>
      <p class="text-muted mb-6 text-sm">Add items to get started.</p>
      <a href="/en/shop" class="btn-primary px-6 py-3 text-sm rounded-lg">Continue shopping</a>
    </div>

    <!-- Cart content -->
    <div id="cart-content" class="grid md:grid-cols-[1fr_360px] gap-10" style="display:none">
      <!-- Left: items + shipping -->
      <div>
        <div id="cart-items" class="mb-8"></div>

        <!-- Shipping section — only for physical items -->
        <div id="shipping-section" class="mb-8" style="display:none">
          <div class="border border-gray-200 dark:border-slate-700 rounded-xl p-5">
            <h2 class="text-base font-semibold mb-4 flex items-center gap-2">
              <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path
                  d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-1.5 6M7 13l-1.5 6m0 0h9m-9 0a1.5 1.5 0 103 0m6 0a1.5 1.5 0 103 0"
                ></path>
              </svg>
              Delivery address
            </h2>

            <div class="grid grid-cols-1 gap-3">
              <div>
                <label class="block text-xs font-medium text-muted mb-1">Full name *</label>
                <input
                  id="ship-name"
                  type="text"
                  placeholder="Jane Smith"
                  autocomplete="name"
                  class="w-full bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-default focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                />
              </div>
              <div>
                <label class="block text-xs font-medium text-muted mb-1">Address *</label>
                <input
                  id="ship-line1"
                  type="text"
                  placeholder="123 Main Street"
                  autocomplete="address-line1"
                  class="w-full bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-default focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                />
              </div>
              <div>
                <label class="block text-xs font-medium text-muted mb-1">Address line 2</label>
                <input
                  id="ship-line2"
                  type="text"
                  placeholder="Apartment, building, etc."
                  autocomplete="address-line2"
                  class="w-full bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-default focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                />
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-medium text-muted mb-1">City *</label>
                  <input
                    id="ship-city"
                    type="text"
                    placeholder="Cotonou"
                    autocomplete="address-level2"
                    class="w-full bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-default focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                  />
                </div>
                <div id="ship-postal-wrap">
                  <label class="block text-xs font-medium text-muted mb-1">Postal code<span id="ship-postal-star"></span></label>
                  <input
                    id="ship-postal"
                    type="text"
                    placeholder="75001"
                    autocomplete="postal-code"
                    class="w-full bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-default focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                  />
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-medium text-muted mb-1">State / Province</label>
                  <input
                    id="ship-state"
                    type="text"
                    placeholder="Littoral"
                    autocomplete="address-level1"
                    class="w-full bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-default focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                  />
                </div>
                <div>
                  <label class="block text-xs font-medium text-muted mb-1">Country *</label>
                  <select id="ship-country" autocomplete="country" class="w-full bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-default focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"><option value="">Select a country…</option></select>
                </div>
              </div>
              <div id="ship-phone-home"><div>
                <label class="block text-xs font-medium text-muted mb-1">Phone / WhatsApp *</label>
                <div class="flex gap-2">
                  <select id="ship-dial" aria-label="Country code" class="w-28 shrink-0 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-default focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"></select>
                  <input
                    id="ship-phone"
                    type="tel"
                    inputmode="tel"
                    placeholder="01 61 00 00 00"
                    autocomplete="tel-national"
                    class="flex-1 min-w-0 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-default focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                  />
                </div>
                <p id="ship-phone-hint" class="text-xs text-muted mt-1">The courier will call this number.</p>
              </div></div>
            </div>
          </div>
        </div>

        <!-- Contact: services only (no address, but we keep a phone number) -->
        <div id="contact-section" class="mb-8" style="display:none">
          <div class="border border-gray-200 dark:border-slate-700 rounded-xl p-5">
            <h2 class="text-base font-semibold mb-4">Contact</h2>
            <div id="contact-phone-slot"></div>
          </div>
        </div>

        <!-- Discount code -->
        <div class="border border-gray-200 dark:border-slate-700 rounded-xl p-5">
          <h2 class="text-base font-semibold mb-3">Promo code</h2>
          <div class="flex gap-2">
            <input
              id="discount-input"
              type="text"
              placeholder="MYCODE"
              class="flex-1 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-default focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary uppercase"
            />
            <button id="discount-btn" type="button" class="btn px-4 py-2.5 text-sm rounded-lg"> Apply </button>
          </div>
          <p id="discount-msg" class="text-sm mt-2" style="display:none"></p>
        </div>
      </div>

      <!-- Right: order summary -->
      <div>
        <div class="border border-gray-200 dark:border-slate-700 rounded-xl p-5 md:sticky md:top-24">
          <h2 class="text-base font-semibold mb-4">Order summary</h2>

          <div class="space-y-2 text-sm mb-4">
            <div class="flex justify-between">
              <span class="text-muted">Subtotal</span>
              <span id="summary-subtotal" class="font-medium text-default">—</span>
            </div>
            <div id="summary-discount-row" class="flex justify-between" style="display:none">
              <span class="text-muted">Discount</span>
              <span id="summary-discount" class="font-medium text-green-600">—</span>
            </div>
            <div class="flex justify-between">
              <span class="text-muted">Shipping</span>
              <span class="font-medium text-default">Calculated at checkout</span>
            </div>
            <div
              class="border-t border-gray-200 dark:border-slate-700 pt-2 flex justify-between text-base font-semibold"
            >
              <span>Total</span>
              <span id="summary-total">—</span>
            </div>
          </div>

          <div id="payment-method-section" class="mb-4" style="display:none">
            <p class="text-xs font-medium text-muted mb-2">Payment method</p>
            <label class="flex items-start gap-2 p-3 rounded-lg border border-gray-200 dark:border-slate-700 cursor-pointer mb-2">
              <input type="radio" name="payment-method" value="online" checked class="mt-1" />
              <span class="text-sm"><span class="font-medium">Pay online</span><span class="block text-xs text-muted">Bank card or Mobile Money</span></span>
            </label>
            <label class="flex items-start gap-2 p-3 rounded-lg border border-gray-200 dark:border-slate-700 cursor-pointer">
              <input type="radio" name="payment-method" value="cod" class="mt-1" />
              <span class="text-sm"><span class="font-medium">Pay on delivery</span><span class="block text-xs text-muted">You pay in cash when your order arrives.</span></span>
            </label>
            <label id="deposit-option" class="flex items-start gap-2 p-3 rounded-lg border border-gray-200 dark:border-slate-700 cursor-pointer mt-2" style="display:none">
              <input type="radio" name="payment-method" value="deposit" class="mt-1" />
              <span class="text-sm"><span id="deposit-title" class="font-medium">Pay a deposit</span><span id="deposit-sub" class="block text-xs text-muted"></span></span>
            </label>
          </div>

          <button
            id="checkout-btn"
            data-checkout-btn
            type="button"
            class="w-full btn-primary py-3 text-sm rounded-lg font-semibold"
          >
            Checkout
          </button>

          <p id="checkout-error" class="text-red-500 text-xs mt-3 text-center" style="display:none"></p>

          <div class="mt-4 flex items-center justify-center gap-2 text-xs text-muted">
            <span>Visa</span><span>·</span><span>Mastercard</span><span>·</span><span>FedaPay</span>
          </div>

          <p class="mt-3 text-xs text-muted text-center">
            By placing your order, you accept our
            <a href="/en/terms" class="underline hover:text-default">terms of sale</a>. A problem with your order?
            <a href="/en/refund-policy" class="underline hover:text-default">Returns and refunds</a>.
          </p>

          <a
            href="https://wa.me/2290194458956?text=Hello%2C%20I%20have%20a%20question%20before%20placing%20an%20order."
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 flex items-center justify-center gap-2 text-sm font-medium text-primary hover:underline"
          >
            A question? Message us on WhatsApp
          </a>
        </div>
      </div>

      <!-- Mobile only: sticky bar so the total and the checkout button are
           always reachable without scrolling past the shipping/promo sections -->
      <div
        class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white dark:bg-slate-900 border-t border-gray-200 dark:border-slate-700 px-4 pt-3 shadow-[0_-4px_12px_rgba(0,0,0,0.08)]"
        style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));"
      >
        <p id="mobile-checkout-error" class="text-red-500 text-xs mb-2 text-center" style="display:none"></p>
        <div class="flex items-center gap-4">
          <div class="shrink-0">
            <p class="text-xs text-muted leading-none mb-1">Total</p>
            <p id="mobile-total" class="text-base font-semibold text-default leading-none">—</p>
          </div>
          <button data-checkout-btn type="button" class="flex-1 btn-primary py-3 text-sm rounded-lg font-semibold">
            Checkout
          </button>
        </div>
      </div>
    </div>
  </div>
</StoreLayout>

<script>
  import type { CartLineItem } from '~/scripts/cart';
  import { countryList, postalRule, buildPhone } from '~/scripts/geo';
  import { setCartContact } from '~/scripts/api';
  import {
    getCart,
    updateQty,
    removeFromCart,
    clearCart as clearCartBase,
    cartSubtotal,
    cartHasPhysical,
    updateCartBadge,
    formatPrice,
  } from '~/scripts/cart';
  import {
    createCart,
    addCartItems,
    setCartShipping,
    fedaPayCheckout,
    stripeCheckout,
    currency as getCurrency,
    provider as getProvider,
  } from '~/scripts/api';
  import { getBookingSlots, holdBookingSlot } from '~/scripts/api';
  import { depositPreview, depositCheckout } from '~/scripts/api';
  import { codCheckout, codCountries } from '~/scripts/api';

  const CURRENCY = getCurrency();
  const PROVIDER = getProvider();

  let appliedDiscount: { code: string; amount_cents: number } | null = null;

  // ── Render ────────────────────────────────────────────────

  function render() {
    updateCartBadge();
    const cart = getCart();
    const emptyEl = document.getElementById('empty-cart')!;
    const contentEl = document.getElementById('cart-content')!;

    if (cart.length === 0) {
      emptyEl.style.display = 'block';
      contentEl.style.display = 'none';
      return;
    }

    emptyEl.style.display = 'none';
    contentEl.style.display = 'grid';

    renderItems(cart);
    renderPickers(cart);
    renderSummary(cart);
    renderShippingSection(cart);
    updatePaymentSection(cart);
  }

  // ── Payment method (online / pay on delivery) ────────────────
  const COD_COUNTRIES = codCountries();
  const LABEL_DEFAULT = 'Checkout';
  const LABEL_COD = 'Place order';
  const LABEL_DEPOSIT = 'Pay deposit';

  // Deposit offer: asked to the API once per cart content (the cart itself is local until checkout).
  let depositQuote: { eligible: boolean; deposit_cents: number; balance_cents: number; due_days: number } | null = null;
  let depositKey = '';
  function refreshDeposit(cart: CartLineItem[]) {
    const key = cart.map((i) => `${i.sku}:${i.qty}`).join(',');
    if (key === depositKey) return;
    depositKey = key;
    depositQuote = null;
    if (cart.length === 0 || cart.some((i) => i.product_type === 'digital')) return;
    depositPreview(cart.map((i) => ({ sku: i.sku, qty: i.qty })))
      .then((q) => { if (depositKey === key) { depositQuote = q; updatePaymentSection(getCart()); } })
      .catch(() => { /* no deposit offer if the preview fails */ });
  }

  function codEligible(cart: CartLineItem[]): boolean {
    if (COD_COUNTRIES.length === 0 || cart.length === 0) return false;
    if (cart.some((i) => i.product_type === 'digital')) return false;
    if (!cartHasPhysical(cart)) return true; // services only: nothing to deliver, pay on the day
    const country = ((document.getElementById('ship-country') as HTMLInputElement | null)?.value ?? '')
      .trim().toUpperCase();
    return COD_COUNTRIES.includes(country);
  }

  function selectedPayment(cart: CartLineItem[]): 'online' | 'cod' | 'deposit' {
    const checked = document.querySelector<HTMLInputElement>('input[name="payment-method"]:checked');
    if (checked?.value === 'deposit' && depositQuote?.eligible) return 'deposit';
    return checked?.value === 'cod' && codEligible(cart) ? 'cod' : 'online';
  }

  function syncPaymentLabels() {
    const method = selectedPayment(getCart());
    setCheckoutButtons(method === 'cod' ? LABEL_COD : method === 'deposit' ? LABEL_DEPOSIT : LABEL_DEFAULT, false);
  }

  function updatePaymentSection(cart: CartLineItem[]) {
    const section = document.getElementById('payment-method-section');
    if (!section) return;
    refreshDeposit(cart);
    const codOk = codEligible(cart);
    const depOk = !!depositQuote?.eligible;
    const eligible = codOk || depOk;
    const codLabel = document.querySelector<HTMLInputElement>('input[name="payment-method"][value="cod"]')?.closest('label') as HTMLElement | null;
    if (codLabel) codLabel.style.display = codOk ? 'flex' : 'none';
    const depLabel = document.getElementById('deposit-option');
    if (depLabel) depLabel.style.display = depOk ? 'flex' : 'none';
    if (depOk) {
      document.getElementById('deposit-title')!.textContent = 'Pay a deposit of ' + formatPrice(depositQuote!.deposit_cents, CURRENCY);
      document.getElementById('deposit-sub')!.textContent = 'The balance of ' + formatPrice(depositQuote!.balance_cents, CURRENCY) + ' is due within ' + depositQuote!.due_days + ' days, online or on delivery.';
    }
    const picked = document.querySelector<HTMLInputElement>('input[name="payment-method"]:checked')?.value;
    if ((picked === 'deposit' && !depOk) || (picked === 'cod' && !codOk)) {
      const online = document.querySelector<HTMLInputElement>('input[name="payment-method"][value="online"]');
      if (online) online.checked = true;
    }
    section.style.display = eligible ? 'block' : 'none';
    if (!eligible) {
      const online = document.querySelector<HTMLInputElement>('input[name="payment-method"][value="online"]');
      if (online) online.checked = true;
    }
    syncPaymentLabels();
  }

  // ── Appointment slots (services with online booking) ─────────
  // The picked slot is kept locally until checkout, where it is held on the server
  // (see holdAll) right before payment starts.
  const BOOKING_KEY = 'santenatur_bookings';
  const SLOT_LOCALE = 'en-GB';
  const CUSTOMER_TZ = (() => { try { return Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch { return ''; } })();
  type Slot = { start: string; end: string; available: boolean };
  type SlotInfo = { bookable: boolean; duration_min?: number; tz?: string; slots: Slot[] };
  const slotInfo: Record<string, SlotInfo | 'loading' | undefined> = {};
  const pickedDay: Record<string, string> = {};

  function readBookings(): Record<string, string> {
    try { return JSON.parse(localStorage.getItem(BOOKING_KEY) || '{}') || {}; } catch { return {}; }
  }
  function writeBookings(b: Record<string, string>) {
    try { localStorage.setItem(BOOKING_KEY, JSON.stringify(b)); } catch { /* private mode: selection lives for this page only */ memoryBookings = b; }
  }
  let memoryBookings: Record<string, string> | null = null;
  function currentBookings(): Record<string, string> { return memoryBookings ?? readBookings(); }
  function clearBookings() { memoryBookings = null; try { localStorage.removeItem(BOOKING_KEY); } catch { /* ignore */ } }
  // The cart is emptied right after a successful checkout: forget the slot with it.
  function clearCart() { clearCartBase(); clearBookings(); }

  const dayKey = (iso: string) => new Date(iso).toLocaleDateString('en-CA');
  const fmtDayBtn = (key: string) => new Intl.DateTimeFormat(SLOT_LOCALE, { weekday: 'short', day: 'numeric', month: 'short' }).format(new Date(key + 'T12:00:00'));
  const fmtTimeBtn = (iso: string) => new Intl.DateTimeFormat(SLOT_LOCALE, { hour: '2-digit', minute: '2-digit' }).format(new Date(iso));
  const fmtFull = (iso: string) => new Intl.DateTimeFormat(SLOT_LOCALE, { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }).format(new Date(iso));
  const escHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  function loadSlots(sku: string): Promise<void> {
    if (slotInfo[sku] !== undefined) return Promise.resolve();
    slotInfo[sku] = 'loading';
    return getBookingSlots(sku)
      .then((r) => { slotInfo[sku] = r; })
      .catch(() => { slotInfo[sku] = undefined; });
  }

  function validSelection(sku: string): string | null {
    const info = slotInfo[sku];
    const start = currentBookings()[sku];
    if (!start || !info || info === 'loading' || !info.bookable) return null;
    return info.slots.some((s) => s.start === start && s.available) ? start : null;
  }

  function renderPickers(cart: CartLineItem[]) {
    for (const item of cart) {
      if (item.product_type !== 'service') continue;
      const box = document.querySelector<HTMLElement>(`[data-slot-sku="${item.sku}"]`);
      if (!box) continue;
      const info = slotInfo[item.sku];
      if (info === undefined) {
        loadSlots(item.sku).then(() => renderPickers(getCart()));
        continue;
      }
      if (info === 'loading') { box.style.display = 'block'; box.innerHTML = `<p class="text-xs text-muted">Loading time slots…</p>`; continue; }
      if (!info.bookable) { box.style.display = 'none'; continue; }
      if (item.qty !== 1) { updateQty(item.sku, 1); render(); return; }

      box.style.display = 'block';
      const byDay = new Map<string, Slot[]>();
      for (const s of info.slots) byDay.set(dayKey(s.start), [...(byDay.get(dayKey(s.start)) ?? []), s]);
      const days = [...byDay.keys()];
      const picked = validSelection(item.sku);
      if (!byDay.size || !days.some((d) => byDay.get(d)!.some((s) => s.available))) {
        box.innerHTML = `<p class="text-sm text-muted">No time slots available right now. Message us to arrange a date.</p>`;
        continue;
      }
      let day = pickedDay[item.sku];
      if (!day || !byDay.has(day)) day = picked ? dayKey(picked) : days.find((d) => byDay.get(d)!.some((s) => s.available))!;
      pickedDay[item.sku] = day;
      const d = info.duration_min ?? 60, tz = escHtml(CUSTOMER_TZ || info.tz || '');
      const dayBtns = days.map((k) => {
        const free = byDay.get(k)!.some((s) => s.available);
        return `<button type="button" data-slot-day="${k}" data-sku="${item.sku}" class="shrink-0 rounded-lg border px-3 py-1.5 text-sm ${k === day ? 'btn-primary border-transparent' : 'border-gray-200 dark:border-slate-700'} ${free ? '' : 'opacity-40'}">${fmtDayBtn(k)}</button>`;
      }).join('');
      const timeBtns = byDay.get(day)!.map((s) => s.available
        ? `<button type="button" data-slot-start="${s.start}" data-sku="${item.sku}" class="rounded-lg border px-3 py-1.5 text-sm ${s.start === picked ? 'btn-primary border-transparent' : 'border-gray-200 dark:border-slate-700 hover:border-primary'}">${fmtTimeBtn(s.start)}</button>`
        : `<button type="button" disabled title="Slot unavailable" class="rounded-lg border border-gray-100 dark:border-slate-800 px-3 py-1.5 text-sm text-muted line-through opacity-50 cursor-not-allowed">${fmtTimeBtn(s.start)}</button>`
      ).join('');
      box.innerHTML = `
        <div class="rounded-lg border border-gray-200 dark:border-slate-700 p-3">
          <p class="text-sm font-medium mb-0.5">Choose your time slot</p>
          <p class="text-xs text-muted mb-3">${`${d} min session · times shown in your time zone (${tz})`}</p>
          <div class="flex gap-2 overflow-x-auto pb-2">${dayBtns}</div>
          <div class="flex flex-wrap gap-2 mt-2">${timeBtns}</div>
          ${picked ? `<p class="text-sm mt-3"><span class="text-muted">Your slot:</span> <strong>${escHtml(fmtFull(picked))}</strong></p>` : ''}
        </div>`;
      box.querySelectorAll<HTMLElement>('[data-slot-day]').forEach((b) => b.addEventListener('click', () => {
        pickedDay[b.dataset.sku!] = b.dataset.slotDay!;
        renderPickers(getCart());
      }));
      box.querySelectorAll<HTMLElement>('[data-slot-start]').forEach((b) => b.addEventListener('click', () => {
        writeBookings({ ...currentBookings(), [b.dataset.sku!]: b.dataset.slotStart! });
        clearError();
        renderPickers(getCart());
      }));
    }
  }

  /** Waits for the availability of every service in the cart, then returns the first one that still needs a slot. */
  async function firstMissingSlot(cart: CartLineItem[]): Promise<CartLineItem | null> {
    const services = cart.filter((i) => i.product_type === 'service');
    await Promise.all(services.map((i) => loadSlots(i.sku)));
    for (const i of services) {
      const info = slotInfo[i.sku];
      if (info && info !== 'loading' && info.bookable && !validSelection(i.sku)) return i;
    }
    return null;
  }

  /** Holds the chosen slots on the server for this (backend) cart, right before payment starts. */
  async function holdAll(cartId: string, cart: CartLineItem[]) {
    const sel = currentBookings();
    for (const i of cart) {
      const info = slotInfo[i.sku];
      if (!info || info === 'loading' || !info.bookable) continue;
      try {
        await holdBookingSlot(cartId, i.sku, sel[i.sku], CUSTOMER_TZ || undefined);
      } catch (e: any) {
        if (e?.code === 'slot_taken' || e?.code === 'slot_unavailable' || e?.status === 409) {
          const rest = { ...currentBookings() }; delete rest[i.sku]; writeBookings(rest);
          slotInfo[i.sku] = undefined;           // reload fresh availability
          renderPickers(getCart());
          throw new Error('That time was just taken. Please choose another.');
        }
        throw e;
      }
    }
  }

  function renderItems(cart: CartLineItem[]) {
    const container = document.getElementById('cart-items')!;
    container.innerHTML = cart
      .map(
        (item) => `
      <div class="flex gap-4 py-4 border-b border-gray-100 dark:border-slate-800" data-sku="${item.sku}">
        <div class="w-16 h-16 bg-gray-100 dark:bg-slate-800 rounded-lg overflow-hidden flex-shrink-0">
          ${
            item.image_url
              ? `<img src="${item.image_url}" alt="${item.title}" class="w-full h-full object-cover" loading="lazy">`
              : `<div class="w-full h-full flex items-center justify-center text-muted text-xs">IMG</div>`
          }
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-medium text-default text-sm">${item.title}</p>
          ${item.variant_title ? `<p class="text-xs text-muted">${item.variant_title}</p>` : ''}
          ${
            item.product_type === 'digital'
              ? `<span class="text-xs text-accent font-medium">⚡ Digital</span>`
              : item.product_type === 'service'
                ? `<span class="text-xs text-primary font-medium">Service</span>`
                : `<span class="text-xs text-muted">Shipping required</span>`
          }
        </div>
        <div class="flex flex-col items-end gap-2">
          <p class="font-semibold text-sm text-default">${formatPrice(item.price_cents * item.qty, CURRENCY)}</p>
          ${
            item.product_type === 'physical'
              ? `<div class="flex items-center gap-1">
                <button class="qty-btn w-7 h-7 rounded border border-gray-200 dark:border-slate-700 text-sm hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors flex items-center justify-center" data-sku="${item.sku}" data-delta="-1">−</button>
                <span class="w-6 text-center text-sm font-medium">${item.qty}</span>
                <button class="qty-btn w-7 h-7 rounded border border-gray-200 dark:border-slate-700 text-sm hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors flex items-center justify-center" data-sku="${item.sku}" data-delta="1">+</button>
              </div>`
              : `<span class="text-xs text-muted">Qty: ${item.qty}</span>`
          }
          <button class="remove-btn text-xs text-red-400 hover:text-red-600 transition-colors" data-sku="${item.sku}">Remove</button>
        </div>
      </div>
      <div data-slot-sku="${item.sku}" class="pb-4 border-b border-gray-100 dark:border-slate-800" style="display:none"></div>
    `
      )
      .join('');

    container.querySelectorAll('.qty-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const sku = el.dataset.sku!;
        const delta = Number(el.dataset.delta);
        const item = getCart().find((i) => i.sku === sku);
        if (item) updateQty(sku, item.qty + delta);
        render();
      });
    });

    container.querySelectorAll('.remove-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        removeFromCart((btn as HTMLElement).dataset.sku!);
        render();
      });
    });
  }

  function renderSummary(cart: CartLineItem[]) {
    const subtotal = cartSubtotal(cart);
    const discount = appliedDiscount?.amount_cents ?? 0;
    const total = subtotal - discount;

    document.getElementById('summary-subtotal')!.textContent = formatPrice(subtotal, CURRENCY);
    document.getElementById('summary-total')!.textContent = formatPrice(total, CURRENCY);
    document.getElementById('mobile-total')!.textContent = formatPrice(total, CURRENCY);

    const discountRow = document.getElementById('summary-discount-row')!;
    if (discount > 0) {
      discountRow.style.display = 'flex';
      document.getElementById('summary-discount')!.textContent = `−${formatPrice(discount, CURRENCY)}`;
    } else {
      discountRow.style.display = 'none';
    }
  }

  function renderShippingSection(cart: CartLineItem[]) {
    const section = document.getElementById('shipping-section')!;
    section.style.display = cartHasPhysical(cart) ? 'block' : 'none';
    placePhoneRow(cart);
  }

  // ── Country, phone and postal code ───────────────────────────
  // Country and country-code lists come from ~/scripts/geo (same data as the API and the admin).
  const GEO_LOCALE = 'en';
  const GEO_TXT = {
    pick: "Select a country…",
    optional: "optional",
    hint: "The courier will call this number.",
    hintBJ: "Benin numbers have 10 digits and start with 01 (e.g. 01 61 00 00 00).",
    errCountry: "Please choose a country.",
    errPostal: "Please enter a postal code for this country.",
    errPhone: "Please enter a valid phone (WhatsApp) number.",
  };

  function geoEl<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  function updateGeoHints() {
    const country = geoEl<HTMLSelectElement>('ship-country');
    const dial = geoEl<HTMLSelectElement>('ship-dial');
    if (!country || !dial) return;
    const rule = country.value ? postalRule(country.value) : 'optional';
    const wrap = geoEl('ship-postal-wrap');
    if (wrap) wrap.style.display = rule === 'none' ? 'none' : '';
    const star = geoEl('ship-postal-star');
    if (star) star.textContent = rule === 'required' ? ' *' : ' (' + GEO_TXT.optional + ')';
    const hint = geoEl('ship-phone-hint');
    if (hint) hint.textContent = dial.value === 'BJ' ? GEO_TXT.hintBJ : GEO_TXT.hint;
  }

  function initGeoFields() {
    // The country list is long: without this the grid column that holds the form is as wide as the longest
    // country name and pushes the page sideways on phones.
    document.getElementById('cart-items')?.parentElement?.classList.add('min-w-0');
    const country = geoEl<HTMLSelectElement>('ship-country');
    const dial = geoEl<HTMLSelectElement>('ship-dial');
    if (!country || !dial) return;
    if (!country.dataset.filled) {
      country.dataset.filled = '1';
      const list = countryList(GEO_LOCALE);
      const SEP = '<option disabled>──────────</option>';
      const opts = (label: (c: (typeof list)[number]) => string) =>
        list.map((c, i) => `<option value="${c.iso}">${label(c)}</option>` + (i === 4 ? SEP : '')).join('');
      country.innerHTML = `<option value="">${GEO_TXT.pick}</option>` + opts((c) => c.name);
      dial.innerHTML = opts((c) => `${c.iso} +${c.dial}`);
      dial.value = 'BJ';
      // The country code next to the phone follows the delivery country until the customer changes it.
      dial.addEventListener('change', () => { dial.dataset.touched = '1'; updateGeoHints(); });
      country.addEventListener('change', () => {
        if (!dial.dataset.touched && country.value) dial.value = country.value;
        updateGeoHints();
      });
    }
    updateGeoHints();
  }

  // International form of what the customer typed ("+22901610000000"), or '' when empty.
  function phoneValue(): string {
    const dial = geoEl<HTMLSelectElement>('ship-dial');
    const raw = geoEl<HTMLInputElement>('ship-phone')?.value ?? '';
    return dial ? buildPhone(dial.value, raw) : '';
  }

  // Delivery carts keep the phone in the address block. Service-only carts have no address,
  // so the same field moves into its own "Contact" box.
  function placePhoneRow(cart: CartLineItem[]) {
    const row = geoEl('ship-phone')?.parentElement?.parentElement;   // label + [code | number] + hint
    const home = geoEl('ship-phone-home');
    const slot = geoEl('contact-phone-slot');
    const box = geoEl('contact-section');
    if (!row || !home || !slot || !box) return;
    const servicesOnly = !cartHasPhysical(cart) && cart.some((i) => i.product_type === 'service');
    const target = servicesOnly ? slot : home;
    if (row.parentElement !== target) target.appendChild(row);
    box.style.display = servicesOnly ? 'block' : 'none';
  }

  // First problem with country / postal code / phone, in the page language (the API checks again).
  // `delivery` is false for service-only carts: no address, only the phone.
  function contactError(delivery: boolean): string | null {
    if (delivery) {
      const country = geoEl<HTMLSelectElement>('ship-country')?.value ?? '';
      if (!country) return GEO_TXT.errCountry;
      const postal = (geoEl<HTMLInputElement>('ship-postal')?.value ?? '').trim();
      if (postalRule(country) === 'required' && !postal) return GEO_TXT.errPostal;
    }
    const digits = phoneValue().replace(/\D/g, '');
    if (digits.length < 8 || digits.length > 15) return GEO_TXT.errPhone;
    return null;
  }

  // ── Discount ──────────────────────────────────────────────
  // Discount is validated on the backend after cart creation.
  // For now we store the code and apply it after createCart().
  // TODO: add a lightweight public validation endpoint to give
  //       immediate feedback before checkout.

  function handleApplyDiscount() {
    const input = document.getElementById('discount-input') as HTMLInputElement;
    const code = input.value.trim().toUpperCase();
    const msg = document.getElementById('discount-msg')!;

    if (!code) return;

    // Store code for application at checkout time
    (window as any).__pendingDiscountCode = code;
    msg.textContent = `Code "${code}" will be applied to your order.`;
    msg.className = 'text-sm mt-2 text-green-600';
    msg.style.display = 'block';
  }

  // ── Checkout pipeline ─────────────────────────────────────

  // Both the summary button and the mobile sticky-bar button run the same flow.
  function checkoutButtons(): HTMLButtonElement[] {
    return Array.from(document.querySelectorAll<HTMLButtonElement>('[data-checkout-btn]'));
  }

  function setCheckoutButtons(label: string, disabled: boolean) {
    checkoutButtons().forEach((b) => {
      b.textContent = label;
      b.disabled = disabled;
    });
  }

  async function handleCheckout() {
    const cart = getCart();
    if (cart.length === 0) return;

    const hasPhysical = cartHasPhysical(cart);

    // Validate shipping address if needed
    if (hasPhysical) {
      const line1 = (document.getElementById('ship-line1') as HTMLInputElement).value.trim();
      const city = (document.getElementById('ship-city') as HTMLInputElement).value.trim();
      const country = (document.getElementById('ship-country') as HTMLInputElement).value.trim();
      if (!line1 || !city || !country) {
        showError('Please fill in the required address fields (address, city, country).');
        // On mobile the fields can be far above the sticky bar — bring them into view.
        document.getElementById('shipping-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
    }

    const payment = selectedPayment(cart);
    // Delivery needs a phone the courier can call (and a postal code where the country uses one);
    // a service needs one too, so the appointment can be confirmed or moved by phone / WhatsApp.
    const hasService = cart.some((i) => i.product_type === 'service');
    if (hasPhysical || hasService) {
      const problem = contactError(hasPhysical);
      if (problem) {
        showError(problem);
        document.getElementById(hasPhysical ? 'shipping-section' : 'contact-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
    }

    // Services with online booking need a chosen time slot.
    const missing = await firstMissingSlot(cart);
    if (missing) {
      showError(`Please choose a time slot for “${missing.title}” before checking out.`);
      document.querySelector(`[data-slot-sku="${missing.sku}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    // Collect email
    const email = await window.promptEmail();
    if (!email) return;

    setCheckoutButtons('Processing...', true);
    clearError();

    try {
      // 1. Create cart on backend
      const backendCart = await createCart(email);
      const cartId = backendCart.id;

      // 2. Add all items
      await addCartItems(
        cartId,
        cart.map((i) => ({ sku: i.sku, qty: i.qty }))
      );

      // 3. Set shipping if needed
      if (hasPhysical) {
        const name = (document.getElementById('ship-name') as HTMLInputElement).value.trim();
        const line1 = (document.getElementById('ship-line1') as HTMLInputElement).value.trim();
        const line2 = (document.getElementById('ship-line2') as HTMLInputElement).value.trim();
        const city = (document.getElementById('ship-city') as HTMLInputElement).value.trim();
        const state = (document.getElementById('ship-state') as HTMLInputElement).value.trim();
        const postal = (document.getElementById('ship-postal') as HTMLInputElement).value.trim();
        const country = (document.getElementById('ship-country') as HTMLInputElement).value.trim();

        await setCartShipping(cartId, {
          name: name || undefined,
          line1,
          line2: line2 || undefined,
          city,
          state: state || undefined,
          postal_code: postal || '',
          phone: phoneValue() || undefined,
          country: country || 'BJ',
        });
      }

      // 3b. Services only: no address to send, but the phone is kept for the appointment.
      if (!hasPhysical && cart.some((i) => i.product_type === 'service')) {
        await setCartContact(cartId, phoneValue());
      }

      // 4. Apply discount if one was entered
      const pendingCode = (window as any).__pendingDiscountCode;
      if (pendingCode) {
        try {
          const { applyDiscount } = await import('~/scripts/api');
          await applyDiscount(cartId, pendingCode);
        } catch {
          // Non-fatal: proceed without discount and inform user
          showError('The promo code could not be applied, but your order is continuing.');
        }
      }

      // 4b. Hold the chosen appointment slots before anything is charged.
      await holdAll(cartId, cart);

      // 5a. Pay on delivery: the order is created right away, no payment page.
      if (payment === 'cod') {
        await codCheckout(cartId);
        clearCart();
        window.location.href = `${window.location.origin}/en/confirmation?cart_id=${cartId}&pm=cod`;
        return;
      }

      // 5b. Deposit: only the deposit goes through the payment page; the order is created when it is confirmed.
      if (payment === 'deposit') {
        const result = await depositCheckout(cartId, `${window.location.origin}/en/confirmation?cart_id=${cartId}&pm=deposit`, `${window.location.origin}/en/cart`, PROVIDER);
        clearCart();
        window.location.href = result.checkout_url;
        return;
      }

      // 5. Redirect to payment
      const origin = window.location.origin;
      const successUrl = `${origin}/en/confirmation?cart_id=${cartId}`;
      const cancelUrl = `${origin}/en/cart`;

      let paymentUrl: string;

      if (PROVIDER === 'stripe') {
        const result = await stripeCheckout(cartId, successUrl, cancelUrl, {
          collectShipping: false, // we already collected it
          shippingCountries: ['BJ', 'FR', 'BE', 'GB', 'CA'],
        });
        paymentUrl = result.checkout_url;
      } else {
        const result = await fedaPayCheckout(cartId, successUrl, cancelUrl);
        paymentUrl = result.checkout_url;
      }

      // Clear local cart only after redirect is certain
      clearCart();
      window.location.href = paymentUrl;
    } catch (err: any) {
      console.error('Checkout failed:', err);
      showError(err.message || 'Something went wrong. Please try again.');
      syncPaymentLabels();
    }
  }

  // Errors show in both the summary card and the mobile sticky bar.
  const ERROR_IDS = ['checkout-error', 'mobile-checkout-error'];

  function showError(msg: string) {
    ERROR_IDS.forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = msg;
      el.style.display = 'block';
    });
  }

  function clearError() {
    ERROR_IDS.forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });
  }

  // ── Init ──────────────────────────────────────────────────
  // Listeners must be (re)bound on every page load AND after every Astro
  // ClientRouter swap: swapped-in DOM nodes are new elements with no
  // listeners. The data-bound flag keeps a node from being bound twice.

  function bindOnce(el: Element | null, handler: () => void) {
    if (!el || (el as HTMLElement).dataset.bound) return;
    (el as HTMLElement).dataset.bound = '1';
    el.addEventListener('click', handler);
  }

  function initCartPage() {
    initGeoFields();
    bindOnce(document.getElementById('discount-btn'), handleApplyDiscount);
    checkoutButtons().forEach((b) => bindOnce(b, handleCheckout));
    if (!(window as any).__payBound) {
      (window as any).__payBound = true;
      document.addEventListener('change', (e) => {
        if ((e.target as HTMLElement | null)?.getAttribute?.('name') === 'payment-method') syncPaymentLabels();
      });
      document.addEventListener('input', (e) => {
        if ((e.target as HTMLElement | null)?.id === 'ship-country') updatePaymentSection(getCart());
      });
    }
    render();
  }

  initCartPage();
  document.addEventListener('astro:after-swap', initCartPage);
</script>
